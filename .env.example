# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://ywlelorrodpbxclnzsiu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SOLO server — nunca se expone al cliente. Bypassa RLS.
SUPABASE_SECRET_KEY=sb_secret_xxx

# === Mercado Pago (opcional) ===
# El sitio funciona sin esto. Cada cliente las carga en su panel, en Conexiones.
# Estas variables solo las usa el tenant de TENANT_CREDENCIALES_GLOBALES, y solo
# si ese cliente todavía no guardó las suyas. "xxx" no cuenta como configurado.
MP_ACCESS_TOKEN=TEST-xxx
MP_PUBLIC_KEY=TEST-xxx
MP_WEBHOOK_SECRET=xxx

# === Google Calendar (opcional) ===
# Igual que Mercado Pago: sin esto el sitio funciona y los turnos quedan en el panel.
# El cliente conecta su calendario desde Conexiones. Estas variables son el respaldo
# del tenant de TENANT_CREDENCIALES_GLOBALES mientras no tenga las suyas.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# === Email (Gmail SMTP) ===
# Cuenta noreply de Gisel. Requiere verificación en 2 pasos y una "contraseña de aplicación".
GMAIL_USER=xxx.noreply@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM="Estética Gisel <xxx.noreply@gmail.com>"

# === Cron (protege los endpoints /api/cron/*) ===
CRON_SECRET=cambiar-por-un-valor-largo-y-aleatorio

# === App ===
# Solo para el logo de los emails hasta la etapa D.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Plataforma (multi-tenant) ===
# Cada cliente es <slug>.<PLATFORM_DOMAIN>. En desarrollo: localhost:3000 → http://gisel.localhost:3000
PLATFORM_DOMAIN=localhost:3000
PLATFORM_PROTOCOLO=http
# Solo para desarrollo y demos: tenant que se muestra cuando el host no es de la plataforma
# (túneles, IP). Dejar vacío en producción (vacío = 404).
TENANT_POR_DEFECTO=gisel
# Solo demos: URL pública con la que se accede al tenant por defecto (ej. el túnel), para links de emails y retorno de Mercado Pago.
URL_TENANT_POR_DEFECTO=
# Hasta la etapa D: tenant dueño de las credenciales MP/Google del .env
TENANT_CREDENCIALES_GLOBALES=gisel
# Cabecera con la IP real del cliente que fija el reverse proxy de confianza (ej. Caddy:
# x-real-ip con {remote_host}), para los límites por IP (login, recuperación, reservas).
# En producción configurarla con la cabecera que el proxy SOBRESCRIBE siempre; nunca
# x-forwarded-for tal como llega de internet (el cliente la falsifica). Vacía: no se
# limita por IP (los límites por email siguen) y el login se limita solo por email: un
# tercero puede trabar una cuenta 15 minutos. En producción es obligatoria.
CABECERA_IP_CONFIABLE=
# Conexión directa a Postgres para scripts/migrar.mjs y el test de aislamiento
# (Supabase → Connect → Session pooler). Solo la usan los scripts: el contenedor la recibe vacía.
SUPABASE_DB_URL=

# === Login en dos pasos (etapa B) ===
# Clave de los HMAC (códigos de login y cookie "mfa"): 32 bytes aleatorios en base64url.
MFA_SECRET=
# Cuenta de Gmail de la PLATAFORMA (no la de un cliente) para códigos de verificación y
# recuperación de contraseña. Requiere verificación en 2 pasos y una "contraseña de aplicación".
# Sin configurar: en desarrollo local (PLATFORM_PROTOCOLO=http o PLATFORM_DOMAIN=localhost…) el código se
# imprime en la consola del servidor; en producción, o con un dominio público por https, el login falla.
# Las tres variables son obligatorias (con una vacía cuenta como no configurada). La dirección de
# PLATFORM_EMAIL_FROM tiene que ser PLATFORM_GMAIL_USER (o un alias "Enviar como" verificado en Gmail).
# Ej.: PLATFORM_EMAIL_FROM="Turnos online <cuenta@gmail.com>"
PLATFORM_GMAIL_USER=
PLATFORM_GMAIL_APP_PASSWORD=
PLATFORM_EMAIL_FROM=
# Usuario master: solo lo lee scripts/crear-master.mjs (el contenedor recibe MASTER_PASSWORD vacía).
# Borrar MASTER_PASSWORD de .env.local después de crear el master.
MASTER_EMAIL=
MASTER_PASSWORD=

# === Panel master (etapa C1) ===
# Clave de cifrado de las credenciales de cada cliente (Gmail, Mercado Pago) en
# tenant_credenciales: AES-256-GCM, 32 bytes aleatorios en base64url. La necesita el
# contenedor (runtime). Si se pierde, hay que volver a cargar todas las credenciales:
# guardarla en un gestor de contraseñas. No cambiarla sin volver a cifrar lo guardado.
CREDENCIALES_KEY=
